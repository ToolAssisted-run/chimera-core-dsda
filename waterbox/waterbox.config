  "_machines_note": "One machine a game, all of them BizHawk's Doom system, each with its game's controller; the IWAD the project brings (any release) and the compatibility level say the rest.",
  "systemNames": {
    "Doom": "Doom"
  },
  "settings": [
    {
      "name": "game",
      "display": "Game",
      "type": "enum",
      "options": [
        "doom2",
        "doom",
        "tnt",
        "plutonia",
        "heretic",
        "hexen",
        "chex",
        "freedoom1",
        "freedoom2"
      ],
      "default": "doom2",
      "description": "Which game the machine is (Chimera's System). It is the game the IWAD belongs to. It is not shown on the settings page."
    },
    {
      "name": "compatibilityLevel",
      "display": "Compatibility Level",
      "type": "enum",
      "options": [
        "0 - Doom v1.2",
        "1 - Doom v1.666",
        "2 - Doom & Doom 2 v1.9",
        "3 - Ultimate Doom & Doom95",
        "4 - Final Doom",
        "5 - DOSDoom",
        "6 - TASDoom",
        "7 - Boom's Vanilla Compatibility Mode",
        "8 - Boom v2.01",
        "9 - Boom v2.02",
        "10 - LxDoom",
        "11 - MBF",
        "12 - PrBoom v2.03beta",
        "13 - PrBoom v2.1.0",
        "14 - PrBoom v2.1.1 - 2.2.6",
        "15 - PrBoom v2.3.x",
        "16 - PrBoom v2.4.0",
        "17 - PrBoom Latest",
        "21 - MBF21"
      ],
      "default": "2 - Doom & Doom 2 v1.9",
      "description": "The version of Doom, or of one of its ports, whose behaviour this movie follows. The highest level that is compatible with the original game is 'Final Doom'. Newer WADs may need a higher level. DSDA-Doom used alone defaults to MBF21, which supports the features of all lower levels but is the furthest from the original game.",
      "when": [
        "doom2",
        "doom",
        "tnt",
        "plutonia",
        "chex",
        "freedoom1",
        "freedoom2"
      ]
    },
    {
      "name": "skillLevel",
      "display": "Skill Level",
      "type": "enum",
      "options": [
        "1 - I'm too young to die",
        "2 - Hey, not too rough",
        "3 - Hurt me plenty",
        "4 - Ultra-Violence",
        "5 - Nightmare!"
      ],
      "default": "4 - Ultra-Violence",
      "description": "The difficulty. The original game defaults to 'Hurt me plenty', but 'Ultra-Violence' is the usual standard today."
    },
    {
      "name": "multiplayerMode",
      "display": "Multiplayer Mode",
      "type": "enum",
      "options": [
        "Single Player / Cooperative",
        "Deathmatch",
        "Alternate Deathmatch (v2.0)"
      ],
      "default": "Single Player / Cooperative",
      "description": "Which multiplayer mode the game is played in."
    },
    {
      "name": "initialEpisode",
      "display": "Initial Episode",
      "type": "int",
      "min": 0,
      "max": 9,
      "default": 1,
      "description": "The episode the game starts in. It is ignored for IWADs without episodes (for example DOOM2) and for Shareware."
    },
    {
      "name": "initialMap",
      "display": "Initial Map",
      "type": "int",
      "min": 1,
      "max": 99,
      "default": 1,
      "description": "The map the game starts in."
    },
    {
      "name": "fastMonsters",
      "display": "Fast Monsters",
      "type": "bool",
      "default": false,
      "description": "Makes monsters move and attack much faster. It is always on at the Nightmare! difficulty."
    },
    {
      "name": "monstersRespawn",
      "display": "Monsters Respawn",
      "type": "bool",
      "default": false,
      "description": "Makes monsters come back to life shortly after dying. It is always on at the Nightmare! difficulty."
    },
    {
      "name": "noMonsters",
      "display": "No Monsters",
      "type": "bool",
      "default": false,
      "description": "Removes all monsters from the level."
    },
    {
      "name": "pistolStart",
      "display": "Pistol Start",
      "type": "bool",
      "default": false,
      "description": "Starts every level from nothing, with no weapons or items kept from earlier levels. Health is also reset to 100%."
    },
    {
      "name": "coopSpawns",
      "display": "Coop Mode Spawns",
      "type": "bool",
      "default": false,
      "description": "Plays a single-player game with the monsters and items that the cooperative mode places."
    },
    {
      "name": "chainEpisodes",
      "display": "Chain Episodes",
      "type": "bool",
      "default": false,
      "description": "Finishing one episode leads to the next without a break. The original game does not have this."
    },
    {
      "name": "alwaysRun",
      "display": "Always Run",
      "type": "bool",
      "default": true,
      "description": "Whether the player always runs, with the slower walking speed not available. This reproduces a bug in the original Doom: setting the joystick run button to an invalid high number makes the game treat it as always pressed."
    },
    {
      "name": "renderWipescreen",
      "display": "Render Wipescreen",
      "type": "bool",
      "default": true,
      "description": "Turns on the screen melt, the effect shown when Doom changes scene, for example when a level starts or ends. The original game cannot turn it off. Its frames are lag frames, in which the game waits."
    },
    {
      "name": "turningResolution",
      "display": "Turning Resolution",
      "type": "enum",
      "options": [
        "16 bits (longtics)",
        "8 bits (shorttics)"
      ],
      "default": "16 bits (longtics)",
      "description": "'Shorttics' is the reduced turning precision normally used for demos. 'Longtics' is the normal turning precision outside demo recording. Newer demo formats support both."
    },
    {
      "name": "mouseTurnSensitivity",
      "display": "Horizontal Mouse Sensitivity",
      "type": "int",
      "min": 0,
      "max": 100,
      "default": 10,
      "description": "How fast the player turns when the mouse is used."
    },
    {
      "name": "mouseRunSensitivity",
      "display": "Vertical Mouse Sensitivity",
      "type": "int",
      "min": 0,
      "max": 100,
      "default": 1,
      "description": "How fast the player runs when the mouse is used."
    },
    {
      "name": "strafe50Turns",
      "display": "Turning During Strafe50",
      "type": "enum",
      "options": [
        "Ignore",
        "Allow"
      ],
      "default": "Allow",
      "description": "The \"Strafe\" key is needed to turn a turning movement into the fastest sideways movement (strafe50). Without it the largest sideways value is 40. So with a keyboard and a mouse it is impossible to turn during strafe50. If strafe50 together with turning appears in a demo, the game accepts it, which makes it possible only in a tool-assisted run. This setting can turn it off for the most authentic behaviour."
    },
    {
      "name": "preventLevelExit",
      "display": "Prevent Level Exit",
      "type": "bool",
      "default": false,
      "description": "Level exits have no effect. This is useful for debugging, optimising and scripted play. The original game does not have this."
    },
    {
      "name": "preventGameEnd",
      "display": "Prevent Game End",
      "type": "bool",
      "default": false,
      "description": "The triggers that end the game have no effect. This is useful for debugging, optimising and scripted play. The original game does not have this."
    },
    {
      "name": "turbo",
      "display": "Turbo",
      "type": "int",
      "min": -1,
      "max": 255,
      "default": -1,
      "description": "Changes the player's running and sideways speed (0 to 255). -1 means it is off."
    },
    {
      "name": "rngSeed",
      "display": "Initial RNG Seed",
      "type": "int",
      "min": 0,
      "max": 2147483647,
      "default": 1993,
      "description": "The starting value (seed) of the game's random number generator. It is used only for compatibility level 7 (Boom) and above. The default value is 1993.",
      "when": [
        "doom2",
        "doom",
        "tnt",
        "plutonia",
        "chex",
        "freedoom1",
        "freedoom2"
      ]
    },
    {
      "name": "player1Present",
      "display": "Player 1 Present",
      "type": "bool",
      "default": true,
      "description": "Whether player 1 is present."
    },
    {
      "name": "player2Present",
      "display": "Player 2 Present",
      "type": "bool",
      "default": false,
      "description": "Whether player 2 is present."
    },
    {
      "name": "player3Present",
      "display": "Player 3 Present",
      "type": "bool",
      "default": false,
      "description": "Whether player 3 is present."
    },
    {
      "name": "player4Present",
      "display": "Player 4 Present",
      "type": "bool",
      "default": false,
      "description": "Whether player 4 is present."
    },
    {
      "name": "player1Class",
      "display": "[Hexen] Player 1 Class",
      "type": "enum",
      "options": [
        "Fighter",
        "Cleric",
        "Mage"
      ],
      "default": "Fighter",
      "description": "The Hexen class of player 1.",
      "when": [
        "hexen"
      ]
    },
    {
      "name": "player2Class",
      "display": "[Hexen] Player 2 Class",
      "type": "enum",
      "options": [
        "Fighter",
        "Cleric",
        "Mage"
      ],
      "default": "Fighter",
      "description": "The Hexen class of player 2.",
      "when": [
        "hexen"
      ]
    },
    {
      "name": "player3Class",
      "display": "[Hexen] Player 3 Class",
      "type": "enum",
      "options": [
        "Fighter",
        "Cleric",
        "Mage"
      ],
      "default": "Fighter",
      "description": "The Hexen class of player 3.",
      "when": [
        "hexen"
      ]
    },
    {
      "name": "player4Class",
      "display": "[Hexen] Player 4 Class",
      "type": "enum",
      "options": [
        "Fighter",
        "Cleric",
        "Mage"
      ],
      "default": "Fighter",
      "description": "The Hexen class of player 4.",
      "when": [
        "hexen"
      ]
    },
    {
      "name": "scaleFactor",
      "display": "Internal Resolution Scale Factor",
      "type": "int",
      "min": 1,
      "max": 12,
      "default": 1,
      "description": "The number the internal resolution is multiplied by (1 to 12). The picture looks sharper but is less faithful to the original. The original game's resolution is 320x200, stretched to a 4:3 shape on a CRT monitor. The core's picture is at most 3840x2400, so the widescreen shapes go up to 5."
    },
    {
      "name": "internalAspect",
      "display": "Internal Aspect Ratio",
      "type": "enum",
      "options": [
        "Native",
        "16:9",
        "16:10",
        "4:3"
      ],
      "default": "Native",
      "description": "The shape of the picture the game draws. 'Native' is a multiple of 320x200, and Chimera stretches it to 4:3, much like the original game. The other choices draw a picture that already has the right shape. That is useful for viewing the Automap at higher resolutions, because it avoids the distorted pixels that stretching afterwards causes."
    },
    {
      "name": "sfxVolume",
      "display": "Sfx Volume",
      "type": "int",
      "min": 0,
      "max": 15,
      "default": 8,
      "description": "The volume of the sound effects (0 to 15)."
    },
    {
      "name": "musicVolume",
      "display": "Music Volume",
      "type": "int",
      "min": 0,
      "max": 15,
      "default": 8,
      "description": "The volume of the music (0 to 15)."
    },
    {
      "name": "gamma",
      "display": "Gamma Correction Level",
      "type": "int",
      "min": 0,
      "max": 4,
      "default": 0,
      "description": "Makes the picture brighter (0 to 4). The original game's default is \"OFF\" (0). The Change Gamma button steps through the values."
    },
    {
      "name": "showMessages",
      "display": "Show Messages",
      "type": "bool",
      "default": true,
      "description": "Shows messages about the items you pick up. The original game's default is \"ON\"."
    },
    {
      "name": "reportSecrets",
      "display": "Report Revealed Secrets",
      "type": "bool",
      "default": false,
      "description": "Shows a message on screen when a secret is found. The original game does not have this."
    },
    {
      "name": "hudMode",
      "display": "HUD Mode",
      "type": "enum",
      "options": [
        "Vanilla",
        "DSDA",
        "None"
      ],
      "default": "Vanilla",
      "description": "Which heads-up display (HUD) is shown."
    },
    {
      "name": "dsdaExHud",
      "display": "Extended HUD",
      "type": "bool",
      "default": false,
      "description": "Shows DSDA-Doom's own information above the original heads-up display. The original game does not have this."
    },
    {
      "name": "displayCoordinates",
      "display": "Display Coordinates",
      "type": "bool",
      "default": false,
      "description": "Shows the player's position, angle, speed and distance travelled per frame. The colour shows the kind of movement: green for SR40, blue for SR50, red for turbo or wallrun. The original game has this through the IDMYPOS cheat code, but it shows only the angle, X and Y."
    },
    {
      "name": "displayCommands",
      "display": "Display Commands",
      "type": "bool",
      "default": false,
      "description": "Shows the recent inputs on the screen. The last 10 are kept, and empty inputs are left out. The original game does not have this."
    },
    {
      "name": "mapTotals",
      "display": "Automap Totals",
      "type": "bool",
      "default": false,
      "description": "Shows the counts of kills, items and secrets on the Automap. The original game does not have this."
    },
    {
      "name": "mapTime",
      "display": "Automap Time",
      "type": "bool",
      "default": false,
      "description": "Shows the elapsed time on the Automap. The original game does not have this."
    },
    {
      "name": "mapCoordinates",
      "display": "Automap Coordinates",
      "type": "bool",
      "default": false,
      "description": "Shows the coordinates within the level on the Automap. The original game does not have this."
    },
    {
      "name": "mapOverlay",
      "display": "Automap Overlay",
      "type": "enum",
      "options": [
        "Disabled",
        "Enabled",
        "Dark"
      ],
      "default": "Disabled",
      "description": "Shows the Automap on top of the game view. The original game does not have this."
    },
    {
      "name": "mapDetails",
      "display": "Automap Details",
      "type": "enum",
      "options": [
        "Normal",
        "Linedefs",
        "Linedefs and things"
      ],
      "default": "Normal",
      "description": "Shows all lines (linedefs) and things on the Automap. The original game has this through the IDDT cheat code."
    },
    {
      "name": "mapTrail",
      "display": "Map Trail",
      "type": "bool",
      "default": false,
      "description": "Shows the player's earlier positions as a trail when Automap Details is on. The original game does not have this."
    },
    {
      "name": "mapTrailSize",
      "display": "Map Trail Size",
      "type": "int",
      "min": 1,
      "max": 350,
      "default": 105,
      "description": "How many earlier positions are shown as a trail on the Automap (1 to 350)."
    },
    {
      "name": "fullVision",
      "display": "Full Vision",
      "type": "bool",
      "default": false,
      "description": "Removes all darkness. The original game has this through the IDBEHOLDL cheat code."
    },
    {
      "name": "displayPlayer",
      "display": "Player Point of View",
      "type": "int",
      "min": 1,
      "max": 4,
      "default": 1,
      "description": "Which player's point of view the picture is drawn from (1 to 4). If that player is not present, the first player who is present is used."
    },
    {
      "name": "soloNet",
      "display": "Solo Net",
      "type": "bool",
      "default": false,
      "description": "Plays a single player as a network game (DSDA-Doom's -solo-net option), which the footer of a demo may ask for. A game with more than one player is a network game anyway."
    },
    {
      "name": "demoOptions",
      "display": "Boom/MBF Options",
      "type": "string",
      "default": "",
      "description": "The game options stored in the header of a demo made for Boom or a later port, written as hexadecimal. They are the 64 bytes of Boom, MBF and PrBoom, or the 21 bytes of MBF21 followed by its compatibility flags. They cover monster memory, friction, pushers, bobbing, demo insurance, infighting, helper dogs and their distance, the monsters' behaviour and the compatibility flags. When this is empty, the defaults of the compatibility level and a PWAD's OPTIONS lump are used, as DSDA-Doom records them. The monster flags and the seed are taken from the settings, not from this value.",
      "when": [
        "doom2",
        "doom",
        "tnt",
        "plutonia",
        "chex",
        "freedoom1",
        "freedoom2"
      ]
    },
    {
      "name": "extendedCommands",
      "display": "Extended Commands",
      "type": "enum",
      "options": [
        "Off",
        "On",
        "On, with casual features"
      ],
      "default": "Off",
      "description": "DSDA-Doom's extended commands, which its own DSDA demo format holds: jumping and free look, and, with the casual features, god mode and walking through walls. It is off for every other demo format."
    },
    {
      "name": "emulatePrBoom",
      "display": "Emulate PrBoom+ Version",
      "type": "string",
      "default": "",
      "description": "Plays the way an older PrBoom+ did (DSDA-Doom's -emulate option, with a version such as 2.5.0.8), which the footer of a demo may ask for. When this is empty, the game plays as DSDA-Doom does."
    },
    {
      "name": "spechitAddress",
      "display": "Spechit Overrun Base Address",
      "type": "int",
      "min": 0,
      "max": 2147483647,
      "default": 0,
      "description": "The memory address that the emulation of the spechit overflow assumes (DSDA-Doom's -spechit option), which the footer of a demo may give. 0 means the address in doom2.exe (0x01C09C98).",
      "when": [
        "doom2",
        "doom",
        "tnt",
        "plutonia",
        "chex",
        "freedoom1",
        "freedoom2"
      ]
    },
    {
      "name": "overrunSpechit",
      "display": "Emulate Spechit Overflow",
      "type": "bool",
      "default": true,
      "description": "Reproduces the original game's spechit overflow bug (DSDA-Doom's overrun_spechit_emulate option, which is on by default).",
      "when": [
        "doom2",
        "doom",
        "tnt",
        "plutonia",
        "chex",
        "freedoom1",
        "freedoom2"
      ]
    },
    {
      "name": "overrunReject",
      "display": "Emulate Reject Overflow",
      "type": "bool",
      "default": true,
      "description": "Reproduces the original game's REJECT overflow bug (the overrun_reject_emulate option, which is on by default).",
      "when": [
        "doom2",
        "doom",
        "tnt",
        "plutonia",
        "chex",
        "freedoom1",
        "freedoom2"
      ]
    },
    {
      "name": "overrunIntercept",
      "display": "Emulate Intercepts Overflow",
      "type": "bool",
      "default": true,
      "description": "Reproduces the original game's intercepts overflow bug (the overrun_intercept_emulate option, which is on by default).",
      "when": [
        "doom2",
        "doom",
        "tnt",
        "plutonia",
        "chex",
        "freedoom1",
        "freedoom2"
      ]
    },
    {
      "name": "overrunPlayeringame",
      "display": "Emulate Playeringame Overflow",
      "type": "bool",
      "default": true,
      "description": "Reproduces the original game's playeringame overflow bug (the overrun_playeringame_emulate option, which is on by default).",
      "when": [
        "doom2",
        "doom",
        "tnt",
        "plutonia",
        "chex",
        "freedoom1",
        "freedoom2"
      ]
    },
    {
      "name": "overrunDonut",
      "display": "Emulate Donut Overflow",
      "type": "bool",
      "default": false,
      "description": "Reproduces the original game's donut overflow bug (the overrun_donut_emulate option, which is off by default).",
      "when": [
        "doom2",
        "doom",
        "tnt",
        "plutonia",
        "chex",
        "freedoom1",
        "freedoom2"
      ]
    },
    {
      "name": "overrunMissedBackside",
      "display": "Emulate Missed Backside Overflow",
      "type": "bool",
      "default": false,
      "description": "Reproduces the original game's missed backside overflow bug (the overrun_missedbackside_emulate option, which is off by default).",
      "when": [
        "doom2",
        "doom",
        "tnt",
        "plutonia",
        "chex",
        "freedoom1",
        "freedoom2"
      ]
    }
  ],
  "firmware": [
    {
      "id": "doom2.wad",
      "display": "Doom II IWAD",
      "description": "DOOM2.WAD is the game. Any release of it can be used, and so can a modified IWAD. You have to supply it. The package contains none of the game's data. The project records exactly which file it was, and the compatibility level decides which release's rules the game follows.",
      "name": "DOOM2.WAD",
      "requiredWhen": {
        "setting": "game",
        "is": "doom2"
      }
    },
    {
      "id": "doom.wad",
