  "movieImport": {
    "menu": "Import Demo (LMP)...",
    "movie": {
      "label": "Demo",
      "extensions": [
        "lmp"
      ]
    },
    "files": [
      {
        "option": "importIwad",
        "label": "IWAD",
        "firmware": true,
        "required": true,
        "extensions": [
          "wad"
        ]
      },
      {
        "option": "importPwads",
        "label": "PWADs and patches, in load order",
        "slot": "pwad",
        "multiple": true,
        "separator": ";",
        "extensions": [
          "wad",
          "deh",
          "bex"
        ]
      }
    ],
    "options": [
      {
        "name": "importNoPwads",
        "display": "No PWADs (an IWAD's own demo)",
        "type": "bool",
        "description": "Uses none of the PWADs and patches named in the demo's footer. It is for the IWADs' own demos, which were recorded with a fix that is now part of the IWAD."
      },
      {
        "name": "importLongtics",
        "display": "Recorded with longtics (Heretic, Hexen)",
        "type": "bool",
        "description": "For a Heretic or Hexen demo that was recorded with -longtics but whose header does not say so (demos from Hexen+, before vvHeretic added a header flag). Its turns are then read as 16-bit values. A demo whose header says so needs nothing."
      },
      {
        "name": "importRespawn",
        "display": "Monsters respawn (Doom 1.0-1.2, Heretic, Hexen)",
        "type": "bool",
        "description": "For a demo that was recorded with -respawn but whose header does not say so. Demos of Doom 1.0 to 1.2 hold no monster flags, and Heretic and Hexen demos hold them only when DSDA-Doom recorded them. A later Doom demo format holds its own flags."
      },
      {
        "name": "importFast",
        "display": "Fast monsters (Doom 1.0-1.2, Heretic, Hexen)",
        "type": "bool",
        "description": "For a demo that was recorded with -fast. The headers of Doom 1.0 to 1.2, Heretic and Hexen demos do not hold this. A later Doom demo format holds its own flag."
      },
      {
        "name": "importNomonsters",
        "display": "No monsters (Doom 1.0-1.2, Heretic, Hexen)",
        "type": "bool",
        "description": "For a demo that was recorded with -nomonsters but whose header does not say so. Demos of Doom 1.0 to 1.2 hold no monster flags, and Heretic and Hexen demos hold them only when DSDA-Doom recorded them. A later Doom demo format holds its own flags."
      }
    ]
  }
}
