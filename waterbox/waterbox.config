  "_machines_note": "One machine a game, all of them BizHawk's Doom system, each with its game's controller; the IWAD the project brings (any release) and the compatibility level say the rest.",
  "systemNames": {
    "Doom": "Doom"
  },
  "settings": [
    {
      "name": "game",
      "display": "setting.game",
      "type": "enum",
      "options": [
        "doom2",
        "doom",
        "tnt",
        "plutonia",
        "heretic",
        "hexen",
        "chex",
        "freedoom1",
        "freedoom2"
      ],
      "default": "doom2",
      "description": "setting.game.about"
    },
    {
      "name": "compatibilityLevel",
      "display": "setting.compatibilitylevel",
      "type": "enum",
      "options": [
        "0 - Doom v1.2",
        "1 - Doom v1.666",
        "2 - Doom & Doom 2 v1.9",
        "3 - Ultimate Doom & Doom95",
        "4 - Final Doom",
        "5 - DOSDoom",
        "6 - TASDoom",
        "7 - Boom's Vanilla Compatibility Mode",
        "8 - Boom v2.01",
        "9 - Boom v2.02",
        "10 - LxDoom",
        "11 - MBF",
        "12 - PrBoom v2.03beta",
        "13 - PrBoom v2.1.0",
        "14 - PrBoom v2.1.1 - 2.2.6",
        "15 - PrBoom v2.3.x",
        "16 - PrBoom v2.4.0",
        "17 - PrBoom Latest",
        "21 - MBF21"
      ],
      "default": "2 - Doom & Doom 2 v1.9",
      "description": "setting.compatibilitylevel.about",
      "when": [
        "doom2",
        "doom",
        "tnt",
        "plutonia",
        "chex",
        "freedoom1",
        "freedoom2"
      ]
    },
    {
