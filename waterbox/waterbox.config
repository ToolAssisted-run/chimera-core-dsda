  ],
  "_machines_note": "One machine a game, all of them BizHawk's Doom system; each narrows the version setting to its IWAD's releases (Chimera's Version), and has its game's controller.",
  "settings": [
    {
      "name": "game",
      "display": "Game",
      "type": "enum",
      "options": [
        "doom2",
        "doom",
        "tnt",
        "plutonia",
        "heretic",
        "hexen",
        "chex",
        "freedoom1",
        "freedoom2"
      ],
      "default": "doom2",
      "description": "Which game the machine is (Chimera's System): the IWAD's. Not on the settings page."
    },
    {
      "name": "version",
      "display": "Version",
      "type": "enum",
      "options": [
        "doom2-1.9",
        "doom-ultimate",
        "tnt",
        "plutonia",
        "heretic-1.2",
        "hexen-1.1",
        "chex",
        "freedoom1-0.13.0",
        "freedoom1-0.12.1",
        "freedoom1-0.12.0",
        "freedoom1-0.11.3",
        "freedoom1-0.11.2",
        "freedoom1-0.11.1",
        "freedoom1-0.11",
        "freedoom2-0.13.0",
        "freedoom2-0.12.1",
        "freedoom2-0.12.0",
        "freedoom2-0.11.3",
        "freedoom2-0.11.2",
        "freedoom2-0.11.1",
        "freedoom2-0.11"
      ],
      "default": "doom2-1.9",
      "description": "Which release of the game's IWAD (Chimera's Version): the IWAD the project brings as firmware, by its hash. Not on the settings page."
    },
    {
      "name": "compatibilityLevel",
      "display": "Compatibility Level",
      "type": "enum",
      "options": [
        "0 - Doom v1.2",
        "1 - Doom v1.666",
        "2 - Doom & Doom 2 v1.9",
        "3 - Ultimate Doom & Doom95",
        "4 - Final Doom",
        "5 - DOSDoom",
        "6 - TASDoom",
        "7 - Boom's Vanilla Compatibility Mode",
        "8 - Boom v2.01",
        "9 - Boom v2.02",
        "10 - LxDoom",
        "11 - MBF",
        "12 - PrBoom v2.03beta",
        "13 - PrBoom v2.1.0",
        "14 - PrBoom v2.1.1 - 2.2.6",
        "15 - PrBoom v2.3.x",
        "16 - PrBoom v2.4.0",
        "17 - PrBoom Latest",
        "21 - MBF21"
      ],
      "default": "2 - Doom & Doom 2 v1.9",
      "description": "The version of Doom or its ports that this movie is meant to emulate. Highest vanilla-compatible level is 'Final Doom'. Newer WADs may require higher levels. Standalone DSDA-Doom defaults to MBF21, which supports features of all of the lower levels, but is the farthest from vanilla.",
      "when": [
        "doom2",
        "doom",
        "tnt",
        "plutonia",
        "chex",
        "freedoom1",
        "freedoom2"
      ]
    },
    {
      "name": "skillLevel",
      "display": "Skill Level",
      "type": "enum",
      "options": [
        "1 - I'm too young to die",
        "2 - Hey, not too rough",
        "3 - Hurt me plenty",
        "4 - Ultra-Violence",
        "5 - Nightmare!"
      ],
      "default": "4 - Ultra-Violence",
      "description": "Difficulty setting. Vanilla defaults to 'Hurt me plenty', but the de-facto current standard is 'Ultra-Violence'."
    },
    {
      "name": "multiplayerMode",
      "display": "Multiplayer Mode",
      "type": "enum",
      "options": [
        "Single Player / Cooperative",
        "Deathmatch",
        "Alternate Deathmatch (v2.0)"
      ],
      "default": "Single Player / Cooperative",
      "description": "Indicates the multiplayer mode."
    },
    {
      "name": "initialEpisode",
      "display": "Initial Episode",
      "type": "int",
      "min": 0,
      "max": 9,
      "default": 1,
      "description": "Selects the initial episode. Ignored for non-episodic IWADs (e.g., DOOM2) and Shareware."
    },
    {
      "name": "initialMap",
      "display": "Initial Map",
      "type": "int",
      "min": 1,
      "max": 99,
      "default": 1,
      "description": "Selects the initial map."
    },
    {
      "name": "fastMonsters",
      "display": "Fast Monsters",
      "type": "bool",
      "default": false,
      "description": "Makes monsters move and attack much faster. Forced to 'true' when playing Nightmare! difficulty."
    },
    {
      "name": "monstersRespawn",
      "display": "Monsters Respawn",
      "type": "bool",
      "default": false,
      "description": "Makes monsters respawn shortly after dying. Forced to 'true' when playing Nightmare! difficulty."
    },
    {
      "name": "noMonsters",
      "display": "No Monsters",
      "type": "bool",
      "default": false,
      "description": "Removes all monsters from the level."
    },
    {
      "name": "pistolStart",
      "display": "Pistol Start",
      "type": "bool",
      "default": false,
      "description": "Starts every level with a clean slate, with nothing carried over from previous levels. Health is reset to 100% as well."
    },
    {
      "name": "coopSpawns",
      "display": "Coop Mode Spawns",
      "type": "bool",
      "default": false,
      "description": "Play single-player mode with cooperative mode thing spawns."
    },
    {
      "name": "chainEpisodes",
      "display": "Chain Episodes",
      "type": "bool",
      "default": false,
      "description": "Completing one episode leads to the next without interruption. Not available in vanilla."
    },
    {
      "name": "alwaysRun",
      "display": "Always Run",
      "type": "bool",
      "default": true,
      "description": "Toggles whether the player is permanently in the running state, without the slower walking speed available. This emulates a bug in vanilla Doom: setting the joystick run button to an invalid high number causes the game to always have it enabled."
    },
    {
      "name": "renderWipescreen",
      "display": "Render Wipescreen",
      "type": "bool",
      "default": true,
      "description": "Enables screen melt - an effect seen when Doom changes scene, for example, when starting or exiting a level. Can't be disabled in vanilla. Its frames are lag: the game waits."
    },
    {
      "name": "turningResolution",
      "display": "Turning Resolution",
      "type": "enum",
      "options": [
        "16 bits (longtics)",
        "8 bits (shorttics)"
      ],
      "default": "16 bits (longtics)",
      "description": "'Shorttics' refers to decreased turning resolution normally used for demos. 'Longtics' refers to the regular turning resolution outside of a demo-recording environment. Newer demo formats support both."
    },
    {
      "name": "mouseTurnSensitivity",
      "display": "Horizontal Mouse Sensitivity",
      "type": "int",
      "min": 0,
      "max": 100,
      "default": 10,
      "description": "How fast the Doom player will turn when using the mouse."
    },
    {
      "name": "mouseRunSensitivity",
      "display": "Vertical Mouse Sensitivity",
      "type": "int",
      "min": 0,
      "max": 100,
      "default": 1,
      "description": "How fast the Doom player will run when using the mouse."
    },
    {
      "name": "strafe50Turns",
      "display": "Turning During Strafe50",
      "type": "enum",
      "options": [
        "Ignore",
        "Allow"
      ],
      "default": "Allow",
      "description": "\"Strafe\" key is required to convert angular movement into strafe50, without it maximum strafe value is 40. So using keyboard and mouse, it's impossible to turn during strafe50. But if strafe50+turning appears in a demo, the game will process it fine, which makes it a TAS-only feature. This setting allows disabling it for maximum authenticity."
    },
    {
      "name": "preventLevelExit",
      "display": "Prevent Level Exit",
      "type": "bool",
      "default": false,
      "description": "Level exit triggers won't have an effect. This is useful for debugging / optimizing / botting purposes. Not available in vanilla."
    },
    {
      "name": "preventGameEnd",
      "display": "Prevent Game End",
      "type": "bool",
      "default": false,
      "description": "Game end triggers won't have an effect. This is useful for debugging / optimizing / botting purposes. Not available in vanilla."
    },
    {
      "name": "turbo",
      "display": "Turbo",
      "type": "int",
      "min": -1,
      "max": 255,
      "default": -1,
      "description": "Modifies the player running / strafing speed [0-255]. '-1' means Disabled."
    },
    {
      "name": "rngSeed",
      "display": "Initial RNG Seed",
      "type": "int",
      "min": 0,
      "max": 2147483647,
      "default": 1993,
      "description": "Only for compatibility level 7 (Boom) and above. Default value is 1993.",
      "when": [
        "doom2",
        "doom",
        "tnt",
        "plutonia",
        "chex",
        "freedoom1",
        "freedoom2"
      ]
    },
    {
      "name": "player1Present",
      "display": "Player 1 Present",
      "type": "bool",
      "default": true,
      "description": "Specifies if player 1 is present"
    },
    {
      "name": "player2Present",
      "display": "Player 2 Present",
      "type": "bool",
      "default": false,
      "description": "Specifies if player 2 is present"
    },
    {
      "name": "player3Present",
      "display": "Player 3 Present",
      "type": "bool",
      "default": false,
      "description": "Specifies if player 3 is present"
    },
    {
      "name": "player4Present",
      "display": "Player 4 Present",
      "type": "bool",
      "default": false,
      "description": "Specifies if player 4 is present"
    },
    {
      "name": "player1Class",
      "display": "[Hexen] Player 1 Class",
      "type": "enum",
      "options": [
        "Fighter",
        "Cleric",
        "Mage"
      ],
      "default": "Fighter",
      "description": "The Hexen class to use for player 1.",
      "when": [
        "hexen"
      ]
    },
    {
      "name": "player2Class",
      "display": "[Hexen] Player 2 Class",
      "type": "enum",
      "options": [
        "Fighter",
        "Cleric",
        "Mage"
      ],
      "default": "Fighter",
      "description": "The Hexen class to use for player 2.",
      "when": [
        "hexen"
      ]
    },
    {
      "name": "player3Class",
      "display": "[Hexen] Player 3 Class",
      "type": "enum",
      "options": [
        "Fighter",
        "Cleric",
        "Mage"
      ],
      "default": "Fighter",
      "description": "The Hexen class to use for player 3.",
      "when": [
        "hexen"
      ]
    },
    {
      "name": "player4Class",
      "display": "[Hexen] Player 4 Class",
      "type": "enum",
      "options": [
        "Fighter",
        "Cleric",
        "Mage"
      ],
      "default": "Fighter",
      "description": "The Hexen class to use for player 4.",
      "when": [
        "hexen"
      ]
    },
    {
      "name": "scaleFactor",
      "display": "Internal Resolution Scale Factor",
      "type": "int",
      "min": 1,
      "max": 12,
      "default": 1,
      "description": "Which factor to increase internal resolution by [1 - 12]. Improves \"quality\" of the rendered image at the cost of accuracy. Vanilla resolution is 320x200 resized to 4:3 DAR on a CRT monitor. The core's picture is at most 3840x2400: the widescreen aspects go up to 5."
    },
    {
      "name": "internalAspect",
      "display": "Internal Aspect Ratio",
      "type": "enum",
      "options": [
        "Native",
        "16:9",
        "16:10",
        "4:3"
      ],
      "default": "Native",
      "description": "Sets aspect ratio of the rendered screen. 'Native' is multiples of 320x200 with aspect correction (to 4:3) applied by the frontend, similar to vanilla. Other modes produce pre-corrected image, useful for viewing Automap on higher resolutions (to avoid pixel distortion caused by external aspect correction)."
    },
    {
      "name": "sfxVolume",
      "display": "Sfx Volume",
      "type": "int",
      "min": 0,
      "max": 15,
      "default": 8,
      "description": "Sound effects volume [0 - 15]."
    },
    {
      "name": "musicVolume",
      "display": "Music Volume",
      "type": "int",
      "min": 0,
      "max": 15,
      "default": 8,
      "description": "[0 - 15]"
    },
    {
      "name": "gamma",
      "display": "Gamma Correction Level",
      "type": "int",
      "min": 0,
      "max": 4,
      "default": 0,
      "description": "Increases brightness [0 - 4]. Default value in vanilla is \"OFF\" (0). The Change Gamma button cycles it."
    },
    {
      "name": "showMessages",
      "display": "Show Messages",
      "type": "bool",
      "default": true,
      "description": "Displays messages about items you pick up. Default value in vanilla is \"ON\"."
    },
    {
      "name": "reportSecrets",
      "display": "Report Revealed Secrets",
      "type": "bool",
      "default": false,
      "description": "Shows an on-screen notification when revealing a secret. Not available in vanilla."
    },
    {
      "name": "hudMode",
      "display": "HUD Mode",
      "type": "enum",
      "options": [
        "Vanilla",
        "DSDA",
        "None"
      ],
      "default": "Vanilla",
      "description": "Sets heads-up display mode."
    },
    {
      "name": "dsdaExHud",
      "display": "Extended HUD",
      "type": "bool",
      "default": false,
      "description": "Shows DSDA-Doom-specific information above vanilla heads-up-display. Not available in vanilla."
    },
    {
      "name": "displayCoordinates",
      "display": "Display Coordinates",
      "type": "bool",
      "default": false,
      "description": "Shows player position, angle, velocity, and distance travelled per frame. Color indicates movement tiers: green - SR40, blue - SR50, red - turbo/wallrun. Available in vanilla via the IDMYPOS cheat code, however vanilla only shows angle, X, and Y."
    },
    {
      "name": "displayCommands",
      "display": "Display Commands",
      "type": "bool",
      "default": false,
      "description": "Shows input history on the screen. History size is 10, empty commands are excluded. Not available in vanilla."
    },
    {
      "name": "mapTotals",
      "display": "Automap Totals",
      "type": "bool",
      "default": false,
      "description": "Shows counts for kills, items, and secrets on Automap. Not available in vanilla."
    },
    {
      "name": "mapTime",
      "display": "Automap Time",
      "type": "bool",
      "default": false,
      "description": "Shows elapsed time on Automap. Not available in vanilla."
    },
    {
      "name": "mapCoordinates",
      "display": "Automap Coordinates",
      "type": "bool",
      "default": false,
      "description": "Shows in-level coordinates on Automap. Not available in vanilla."
    },
    {
      "name": "mapOverlay",
      "display": "Automap Overlay",
      "type": "enum",
      "options": [
        "Disabled",
        "Enabled",
        "Dark"
      ],
      "default": "Disabled",
      "description": "Shows Automap on top of gameplay. Not available in vanilla."
    },
    {
      "name": "mapDetails",
      "display": "Automap Details",
      "type": "enum",
      "options": [
        "Normal",
        "Linedefs",
        "Linedefs and things"
      ],
      "default": "Normal",
      "description": "Exposes all linedefs and things. Available in vanilla via the IDDT cheat code."
    },
    {
      "name": "mapTrail",
      "display": "Map Trail",
      "type": "bool",
      "default": false,
      "description": "Shows previous positions of the player as a trail when Automap details are enabled. Not available in vanilla."
    },
    {
      "name": "mapTrailSize",
      "display": "Map Trail Size",
      "type": "int",
      "min": 1,
      "max": 350,
      "default": 105,
      "description": "Number of previous positions to display as a trail on Automap [1 - 350]."
    },
    {
      "name": "fullVision",
      "display": "Full Vision",
      "type": "bool",
      "default": false,
      "description": "Disables all darkness. Available in vanilla via the IDBEHOLDL cheat code."
    },
    {
      "name": "displayPlayer",
      "display": "Player Point of View",
      "type": "int",
      "min": 1,
      "max": 4,
      "default": 1,
      "description": "Which of the players' point of view to use during rendering [1 - 4]; a player not present falls to the first one present."
    },
    {
      "name": "soloNet",
      "display": "Solo Net",
      "type": "bool",
      "default": false,
      "description": "Plays a single player as a netgame (dsda's -solo-net), as a demo's footer may say. More than one player is a netgame anyway."
    },
    {
      "name": "demoOptions",
      "display": "Boom/MBF Options",
      "type": "string",
      "default": "",
      "description": "The game options a Boom-or-later demo's header holds, as hex: Boom's, MBF's and PrBoom's 64 bytes, or MBF21's 21 and its comp flags. Monster memory, friction, pushers, bobbing, demo insurance, infighting, helper dogs and their distance, the monsters' behaviour, the comp flags. Empty: the complevel's defaults and a PWAD's OPTIONS lump, as dsda records. The monster flags and the seed in it are the settings'.",
      "when": [
        "doom2",
        "doom",
        "tnt",
        "plutonia",
        "chex",
        "freedoom1",
        "freedoom2"
      ]
    },
    {
      "name": "extendedCommands",
      "display": "Extended Commands",
      "type": "enum",
      "options": [
        "Off",
        "On",
        "On, with casual features"
      ],
      "default": "Off",
      "description": "dsda's extended tic commands, which its DSDA demo format holds: jumping and free look, and with the casual features god mode and no clipping. Off for every other demo format."
    },
    {
      "name": "emulatePrBoom",
      "display": "Emulate PrBoom+ Version",
      "type": "string",
      "default": "",
      "description": "Plays as an older PrBoom+ did (dsda's -emulate, a version such as 2.5.0.8), as a demo's footer may ask. Empty: as dsda plays."
    },
    {
      "name": "spechitAddress",
      "display": "Spechit Overrun Base Address",
      "type": "int",
      "min": 0,
      "max": 2147483647,
      "default": 0,
      "description": "The memory address the spechit overflow's emulation assumes (dsda's -spechit), as a demo's footer may say. 0: doom2.exe's (0x01C09C98).",
      "when": [
        "doom2",
        "doom",
        "tnt",
        "plutonia",
        "chex",
        "freedoom1",
        "freedoom2"
      ]
    },
    {
      "name": "overrunSpechit",
      "display": "Emulate Spechit Overflow",
      "type": "bool",
      "default": true,
      "description": "Emulates vanilla's spechit overflow (dsda's overrun_spechit_emulate, on by default).",
      "when": [
        "doom2",
        "doom",
        "tnt",
        "plutonia",
        "chex",
        "freedoom1",
        "freedoom2"
      ]
    },
    {
      "name": "overrunReject",
      "display": "Emulate Reject Overflow",
      "type": "bool",
      "default": true,
      "description": "Emulates vanilla's REJECT overflow (overrun_reject_emulate, on by default).",
      "when": [
        "doom2",
        "doom",
        "tnt",
        "plutonia",
        "chex",
        "freedoom1",
        "freedoom2"
      ]
    },
    {
      "name": "overrunIntercept",
      "display": "Emulate Intercepts Overflow",
      "type": "bool",
      "default": true,
      "description": "Emulates vanilla's intercepts overflow (overrun_intercept_emulate, on by default).",
      "when": [
        "doom2",
        "doom",
        "tnt",
        "plutonia",
        "chex",
        "freedoom1",
        "freedoom2"
      ]
    },
    {
      "name": "overrunPlayeringame",
      "display": "Emulate Playeringame Overflow",
      "type": "bool",
      "default": true,
      "description": "Emulates vanilla's playeringame overflow (overrun_playeringame_emulate, on by default).",
      "when": [
        "doom2",
        "doom",
        "tnt",
        "plutonia",
        "chex",
        "freedoom1",
        "freedoom2"
      ]
    },
    {
      "name": "overrunDonut",
      "display": "Emulate Donut Overflow",
      "type": "bool",
      "default": false,
      "description": "Emulates vanilla's donut overflow (overrun_donut_emulate, off by default).",
      "when": [
        "doom2",
        "doom",
        "tnt",
        "plutonia",
        "chex",
        "freedoom1",
        "freedoom2"
      ]
    },
    {
      "name": "overrunMissedBackside",
      "display": "Emulate Missed Backside Overflow",
      "type": "bool",
      "default": false,
      "description": "Emulates vanilla's missed backside overflow (overrun_missedbackside_emulate, off by default).",
      "when": [
        "doom2",
        "doom",
        "tnt",
        "plutonia",
        "chex",
        "freedoom1",
        "freedoom2"
      ]
    }
  ],
