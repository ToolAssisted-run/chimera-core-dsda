 // The screens to wipe between are already stored, this just does the timing
 // and screen updating
 
+// chimera (BizHawk's core): a frontend that runs the game a tic at a time
+// steps the melt too, a tic a frame (D_StepWipe), where D_Wipe would loop on
+// the clock until it is done
+dboolean frontend_steps_wipe;
+dboolean wipe_in_progress;
+
+dboolean D_StepWipe(void)
+{
+  dboolean done = wipe_ScreenWipe(1);
+
+  M_Drawer();                   // menu is drawn even on top of wipes
+  I_FinishUpdate();             // page flip or blit buffer
+
+  if (done)
+  {
+    wipe_in_progress = false;
+    force_singletics_to = gametic + BACKUPTICS;
+  }
+  return done;
+}
+
